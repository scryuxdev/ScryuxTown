-- 23.5. STRAFE HVH
-- ============================================================
local strafeLeftConn = nil
local strafeRightConn = nil
local strafeLeftEndConn = nil
local strafeRightEndConn = nil

local function StartStrafeHvH()
    if strafeConnection then return end
    if not LP.Character then return end

    strafeLeftConn = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Settings.Movement.StrafeKeyLeft then strafeKeyLeftHeld = true end
        if input.KeyCode == Settings.Movement.StrafeKeyRight then strafeKeyRightHeld = true end
    end)

    strafeLeftEndConn = UserInputService.InputEnded:Connect(function(input)
        if input.KeyCode == Settings.Movement.StrafeKeyLeft then strafeKeyLeftHeld = false end
        if input.KeyCode == Settings.Movement.StrafeKeyRight then strafeKeyRightHeld = false end
    end)

    local lastPeek = 0
    strafeConnection = RunService.Heartbeat:Connect(function()
        if isScriptUnloaded or not Settings.Movement.StrafeEnabled then return end
        local char = LP.Character
        if not char then return end
        local h = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not h or not root or not root:IsA("BasePart") then return end

        local now = os_clock()
        if (now - lastPeek) < Settings.Movement.PeekCooldown then return end

        local strafeDir = 0
        if strafeKeyLeftHeld then strafeDir = -1 end
        if strafeKeyRightHeld then strafeDir = 1 end

        if strafeDir ~= 0 then
            local cam = GetCamera()
            local camRight = cam.CFrame.RightVector
            local offset = camRight * (strafeDir * Settings.Movement.StrafeDistance)
            local newPos = root.Position + offset
            if h.FloorMaterial == Enum.Material.Air or h.MoveDirection.Magnitude < 0.1 then
                pcall(function()
                    root.CFrame = CFrame_new(newPos, newPos + cam.CFrame.LookVector)
                end)
                lastPeek = now
            end
        end
    end)
end

local function StopStrafeHvH()
    if strafeConnection then
        pcall(function() strafeConnection:Disconnect() end)
        strafeConnection = nil
    end
    if strafeLeftConn then pcall(function() strafeLeftConn:Disconnect() end); strafeLeftConn = nil end
    if strafeRightConn then pcall(function() strafeRightConn:Disconnect() end); strafeRightConn = nil end
    if strafeLeftEndConn then pcall(function() strafeLeftEndConn:Disconnect() end); strafeLeftEndConn = nil end
    if strafeRightEndConn then pcall(function() strafeRightEndConn:Disconnect() end); strafeRightEndConn = nil end
end

