local function GetAimAssistTarget()
    if not LP.Character then return nil end
    local lr = LP.Character:FindFirstChild("HumanoidRootPart")
    if not lr then return nil end
    local cam = GetCamera()
    if not cam then return nil end

    local center = helperMousePosition
    local gameFOV = cam.FieldOfView or 70
    local vs = cam.ViewportSize
    local half = vs.X / 2
    local radius = half * math_tan(math_rad(Settings.AimAssist.FOV / 2)) / math_tan(math_rad(gameFOV / 2))

    local best, bestScore = nil, math.huge

    for _, player in ipairs(activePlayers) do
        if not player or player == LP then continue end
        if IsWhitelisted(player) then continue end
        if IsDeadBlacklisted(player.Name) then continue end
        if not player.Character then continue end

        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        if Settings.AimAssist.TeamCheck and player.Team == LP.Team then continue end
        if Settings.AimAssist.IgnorePassive and IsPassive(player.Name) then continue end

        local part = player.Character:FindFirstChild(Settings.AimAssist.AimPart)
        if not part then
            part = player.Character:FindFirstChild("Head")
                or player.Character:FindFirstChild("HumanoidRootPart")
        end
        if not part then continue end

        local tr = player.Character:FindFirstChild("HumanoidRootPart")
        if not tr then continue end
        local dist = (lr.Position - tr.Position).Magnitude
        if Settings.AimAssist.MaxDistance > 0 and dist > Settings.AimAssist.MaxDistance then continue end

        if Settings.AimAssist.WallCheck then
            local vis = CheckVisibility(player)
            if Settings.AimAssist.Visible and vis ~= "visible" then continue end
            if not Settings.AimAssist.Visible and vis == "hidden" then continue end
        end

        local targetPos = part.Position
        if Settings.AimAssist.UsePrediction then
            if tr.Velocity then
                targetPos = targetPos + tr.Velocity * Settings.AimAssist.PredictionAmount
            end
        end

        local sp, onScreen = cam:WorldToViewportPoint(targetPos)
        if not onScreen then continue end

        local dc = (Vector2_new(sp.X, sp.Y) - center).Magnitude
        if dc > radius then continue end

        local score = (Settings.AimAssist.Priority == "Distance") and dist or dc
        if score < bestScore then
            bestScore = score
            best = {
                player = player,
                part = part,
                targetPos = targetPos,
                distance = dist,
                screenDist = dc,
                screenPos = sp,
            }
        end
    end

    return best
end

local function AimAssistLoop()
    if isScriptUnloaded or not Settings.AimAssist.Enabled then return end
    if isLocalDead or IsMenuOpen() then return end
    if Has("isrbxactive") and not isrbxactive() then return end

    local now = os_clock()
    local dt = now - aimAssistLastFrame
    aimAssistLastFrame = now
    if dt > 0.5 then dt = 0.5 end

    local target = GetAimAssistTarget()
    if not target then return end

    local aimPos = target.targetPos
    local sm = Settings.AimAssist.Smoothness
    local cam = GetCamera()

    if Settings.AimAssist.UseMouse then
        local sp = cam:WorldToViewportPoint(aimPos)
        local d = Vector2_new(sp.X - helperMousePosition.X, sp.Y - helperMousePosition.Y)
        if d.Magnitude > 0.5 then
            if sm <= 0 then
                mousemoverel(d.X, d.Y)
            else
                local f = math_clamp(1 - sm, 0.01, 1)
                mousemoverel(d.X * f, d.Y * f)
            end
        end
    else
        if sm <= 0 then
            pcall(function() cam.CFrame = CFrame_new(cam.CFrame.Position, aimPos) end)
        else
            pcall(function()
                local tcf = CFrame_new(cam.CFrame.Position, aimPos)
                local f = math_clamp(1 - sm, 0.01, 1)
                cam.CFrame = cam.CFrame:Lerp(tcf, f)
            end)
        end
    end
end

local function StartAimAssist()
    if aimAssistConnection then return end
    aimAssistActive = true
    aimAssistLastFrame = os_clock()
    aimAssistConnection = RunService.RenderStepped:Connect(AimAssistLoop)

    if not aimAssistFOVCircle then
        aimAssistFOVCircle = Drawing.new("Circle")
        aimAssistFOVCircle.Filled = false
        aimAssistFOVCircle.Visible = false
    end

    if not aimAssistFOVConn then
        aimAssistFOVConn = RunService.RenderStepped:Connect(function()
            if isScriptUnloaded then return end
            if not aimAssistFOVCircle then return end
            aimAssistFOVCircle.Visible = Settings.AimAssist.ShowFOV
                and Settings.AimAssist.Enabled
                and not IsMenuOpen()
            if aimAssistFOVCircle.Visible then
                local cam = GetCamera()
                local gf = cam.FieldOfView or 70
                local half = cam.ViewportSize.X / 2
                local r = half * math_tan(math_rad(Settings.AimAssist.FOV / 2)) / math_tan(math_rad(gf / 2))
                local mp = UserInputService:GetMouseLocation()
                aimAssistFOVCircle.Position = Vector2_new(mp.X, mp.Y)
                aimAssistFOVCircle.Radius = r
                aimAssistFOVCircle.Color = Settings.AimAssist.FOVColor
                aimAssistFOVCircle.Thickness = Settings.AimAssist.FOVThickness
            end
        end)
    end
end

local function StopAimAssist()
    aimAssistActive = false
    if aimAssistConnection then
        pcall(function() aimAssistConnection:Disconnect() end)
        aimAssistConnection = nil
    end
    if aimAssistFOVConn then
        pcall(function() aimAssistFOVConn:Disconnect() end)
        aimAssistFOVConn = nil
    end
    if aimAssistFOVCircle then
        pcall(function() aimAssistFOVCircle:Remove() end)
        aimAssistFOVCircle = nil
    end
end

