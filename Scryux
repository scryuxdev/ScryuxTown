local lastFrameTime = 0

local function CheckAnti360()
    if not Settings.Aimbot.Anti360.Enabled then
        anti360Active = false
        currentTargetForAnti360 = nil
        anti360Cooldown = 0
        return false
    end
    local now = os_clock()
    if anti360Active and now < anti360Cooldown then
        return true
    end
    local lr = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not lr then
        anti360Active = false
        currentTargetForAnti360 = nil
        return false
    end
    local closest, cd = nil, Settings.Aimbot.Anti360.DetectionDistance + Settings.Aimbot.Anti360.Hysteresis
    for _, p in ipairs(activePlayers) do
        if not TargetManager:ValidateTarget(p) then continue end
        if Settings.Aimbot.TeamCheck and p.Team == LP.Team then continue end
        if Settings.Aimbot.IgnorePassive and IsPassive(p.Name) then continue end
        local d = (p.Character.HumanoidRootPart.Position - lr.Position).Magnitude
        if d < cd then cd = d; closest = p end
    end
    if not closest then
        anti360Active = false
        currentTargetForAnti360 = nil
        return false
    end
    local vel = closest.Character.HumanoidRootPart.AssemblyLinearVelocity or Vector3_new(0,0,0)
    local lat = Vector3_new(vel.X, 0, vel.Z)
    if cd <= Settings.Aimbot.Anti360.DetectionDistance and lat.Magnitude > 3 then
        if not anti360Active then
            anti360Active = true
            currentTargetForAnti360 = closest
            anti360Cooldown = now + Settings.Aimbot.Anti360.ReEnableDelay
        end
        return true
    end
    if anti360Active then
        if cd > (Settings.Aimbot.Anti360.DetectionDistance + Settings.Aimbot.Anti360.Hysteresis) then
            anti360Active = false
            currentTargetForAnti360 = nil
            anti360Cooldown = now + Settings.Aimbot.Anti360.ReEnableDelay
            return false
        end
        return true
    end
    return false
end

local function MainAimbotLoop()
    if isScriptUnloaded or not Settings.Aimbot.Enabled then return end
    if isLocalDead or IsMenuOpen() then return end
    if Has("isrbxactive") and not isrbxactive() then return end

    local now = os_clock()
    local dt = now - lastFrameTime
    lastFrameTime = now
    if dt > 0.5 then dt = 0.5 end

    local held
    if Settings.Aimbot.AimKeyType == "Key" then held = aimKeyHeld
    else held = UserInputService:IsMouseButtonPressed(Settings.Aimbot.AimMouseButton) end
    if not held then
        targetTransition.active = false
        return
    end

    if CheckAnti360() then
        TargetManager:ClearTarget()
        targetTransition.active = false
        return
    end

    -- Sticky Lock logic
    if Settings.Aimbot.StickyLock and currentTarget and currentTarget.player then
        local stillValid = TargetManager:ValidateTarget(currentTarget.player)
        if stillValid then
            stickyTarget = currentTarget.player
            stickyLastSeen = now
        else
            if (now - stickyLastSeen) > Settings.Aimbot.StickyTimeout then
                TargetManager:ClearTarget()
                stickyTarget = nil
            end
        end
    elseif not Settings.Aimbot.StickyLock then
        stickyTarget = nil
    end

    TargetManager:UpdateTarget()

    if Settings.Aimbot.StickyLock and stickyTarget and stickyTarget.Character then
        local stHum = stickyTarget.Character:FindFirstChildOfClass("Humanoid")
        if stHum and stHum.Health > 0 then
            local stPart = stickyTarget.Character:FindFirstChild("Head")
                or stickyTarget.Character:FindFirstChild("HumanoidRootPart")
            if stPart then
                currentTarget = {
                    player = stickyTarget,
                    part = stPart,
                    targetPos = stPart.Position,
                    distance = 0,
                    screenDist = 0,
                    screenPos = Vector2_new(0, 0),
                }
            end
        end
    end

    if currentTarget and currentTarget.player ~= targetTransition.previousPlayer then
        local aimPos = currentTarget.part and currentTarget.part.Position or nil
        if aimPos then
            local cam = GetCamera()
            targetTransition.active = true
            targetTransition.startCFrame = cam.CFrame
            targetTransition.targetCFrame = CFrame_new(cam.CFrame.Position, aimPos)
            targetTransition.progress = 0
            targetTransition.duration = TARGET_TRANSITION_DURATION
            targetTransition.previousPlayer = currentTarget.player
        end
    elseif not currentTarget then
        targetTransition.previousPlayer = nil
    end

    if not TargetManager:GetCurrentTarget() then
        local nt = TargetManager:GetBestTarget()
        if nt then
            TargetManager:LockTarget(nt)
            local cam = GetCamera()
            targetTransition.active = true
            targetTransition.startCFrame = cam.CFrame
            targetTransition.targetCFrame = CFrame_new(cam.CFrame.Position, nt.part.Position)
            targetTransition.progress = 0
            targetTransition.duration = TARGET_TRANSITION_DURATION
            targetTransition.previousPlayer = nt.player
        end
    end

    local t = TargetManager:GetCurrentTarget()
    if not t then return end

    if CheckAnti360() then
        TargetManager:ClearTarget()
        targetTransition.active = false
        return
    end

    local ap = t.part
    if not ap or not ap.Parent then
        TargetManager:ClearTarget()
        return
    end

    if targetTransition.active then
        targetTransition.progress = targetTransition.progress + (dt / targetTransition.duration)
        if targetTransition.progress >= 1 then
            targetTransition.progress = 1
            targetTransition.active = false
        end

        local cam = GetCamera()
        local eased = 1 - math.pow(1 - targetTransition.progress, 3)
        local newTargetCF = CFrame_new(cam.CFrame.Position, ap.Position)
        targetTransition.targetCFrame = newTargetCF

        pcall(function()
            cam.CFrame = targetTransition.startCFrame:Lerp(targetTransition.targetCFrame, eased)
        end)
        return
    end

    local aimPos = ap.Position
    if Settings.Aimbot.UsePrediction then
        local root = t.player.Character:FindFirstChild("HumanoidRootPart")
        if root and root.Velocity then
            aimPos = aimPos + root.Velocity * Settings.Aimbot.PredictionAmount
        end
    end

    local sm = aimbotHelperActive and Settings.Aimbot.HelperSmoothness or Settings.Aimbot.BaseSmoothness

    local lr = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if Settings.Aimbot.Anti360.Enabled and lr then
        for _, p in ipairs(activePlayers) do
            if p ~= LP and p.Character then
                local pRoot = p.Character:FindFirstChild("HumanoidRootPart")
                if pRoot then
                    local d = (pRoot.Position - lr.Position).Magnitude
                    if d <= Settings.Aimbot.Anti360.DetectionDistance then
                        sm = 1
                        break
                    end
                end
            end
        end
    end

    local cam = GetCamera()
    if Settings.Aimbot.Method == "Camera" then
        if sm >= 1 then
            return
        elseif sm <= 0 then
            pcall(function() cam.CFrame = CFrame_new(cam.CFrame.Position, aimPos) end)
        else
            pcall(function()
                local tcf = CFrame_new(cam.CFrame.Position, aimPos)
                local f = math_clamp(1 - sm, 0.01, 1)
                cam.CFrame = cam.CFrame:Lerp(tcf, f)
            end)
        end
    else
        local sp = cam:WorldToViewportPoint(aimPos)
        local d = Vector2_new(sp.X - helperMousePosition.X, sp.Y - helperMousePosition.Y)
        if d.Magnitude > 0.5 then
            if sm >= 1 then
                return
            elseif sm <= 0 then
                mousemoverel(d.X, d.Y)
            else
                local f = math_clamp(1 - sm, 0.01, 1)
                mousemoverel(d.X * f, d.Y * f)
            end
        end
    end
end

