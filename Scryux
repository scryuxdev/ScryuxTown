-- 27. CLEANUP
-- ============================================================
_env.TownComplete_Cleanup = function()
    isScriptUnloaded = true

    pcall(function() espConn:Disconnect() end)
    pcall(function() skeletonConn:Disconnect() end)
    pcall(function() fpsCounterConn:Disconnect() end)
    pcall(function() pingUpdateConn:Disconnect() end)
    pcall(function() hudConn:Disconnect() end)
    pcall(function() playerAddedConn:Disconnect() end)
    pcall(function() playerRemovingConn:Disconnect() end)
    pcall(function() localCharConn:Disconnect() end)
    pcall(function() localDiedConn:Disconnect() end)
    pcall(function() aimbotConn:Disconnect() end)
    pcall(function() fovConn:Disconnect() end)
    pcall(function() targetIndicatorConn:Disconnect() end)
    pcall(function() aimKeyBeganConn:Disconnect() end)
    pcall(function() aimKeyEndedConn:Disconnect() end)
    pcall(function() syncCharConn:Disconnect() end)
    pcall(function() panicConn:Disconnect() end)

    StopNoRecoil()
    StopNoSpread()
    StopNoSway()
    StopSyncBooster()
    StopAntiFall()
    StopStrafeHvH()
    StopSpinbot()
    StopHideBody()
    StopAimAssist()
    StopTracerLoop()
    StopXRay()
    setFullBright(false)
    setNoFog(false)
    setNoBloom(false)
    setNoSunRays(false)
    setCustomFOV(false)
    RestoreAllWeaponMods()

    ClearAllESP()
    ClearAllSkeletons()
    ClearAllTracers()

    for _, line in ipairs(SkeletonLinePool) do
        pcall(function() line:Remove() end)
    end
    SkeletonLinePool = {}

    if fovCircle then
        pcall(function() fovCircle:Remove() end)
        fovCircle = nil
    end

    if targetIndicator then
        pcall(function() targetIndicator:Remove() end)
        targetIndicator = nil
    end

    if aimAssistFOVCircle then
        pcall(function() aimAssistFOVCircle:Remove() end)
        aimAssistFOVCircle = nil
    end

    pcall(function() HudLabel:Remove() end)

    stickyTarget = nil
    stickyLastSeen = 0

    for _, c in ipairs(tracerConnections) do
        pcall(function() c:Disconnect() end)
    end
    tracerConnections = {}

    if _env.TownUI_Window then
        pcall(function()
            if _env.TownUI_Window.GetSaveManager then
                local sm = _env.TownUI_Window:GetSaveManager()
                sm:Save("default")
            end
        end)
    end

    _env.TownUI_Window = nil
    _env.TownComplete_Loaded = false
end

