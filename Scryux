local function GetOrCreateESP(playerName)
    local esp = ESPPool[playerName]
    if esp then return esp end

    local box = table_remove(ESPObjectPool.box)
    if not box then
        box = Drawing.new("Square")
        box.Thickness = 1
        box.Filled = false
        box.Visible = false
    end

    local health = table_remove(ESPObjectPool.health)
    if not health then
        health = Drawing.new("Line")
        health.Thickness = 2
        health.Visible = false
    end

    local name = table_remove(ESPObjectPool.name)
    if not name then
        name = Drawing.new("Text")
        name.Size = 16
        name.Center = true
        name.Outline = true
        name.Font = 2
        name.Visible = false
    end

    local chams = table_remove(ESPObjectPool.chams)
    if not chams then
        chams = Instance.new("Highlight")
        chams.FillColor = Settings.ESP.ChamsColor
        chams.OutlineColor = Settings.ESP.ChamsOutlineColor
        chams.FillTransparency = Settings.ESP.ChamsFillTransparency
        chams.OutlineTransparency = Settings.ESP.ChamsOutlineTransparency
        chams.DepthMode = Enum.HighlightDepthMode[Settings.ESP.ChamsDepthMode] or Enum.HighlightDepthMode.AlwaysOnTop
        chams.Enabled = false
        chams.Parent = CoreGui
    else
        chams.Parent = CoreGui
    end

    esp = {
        box = box,
        health = health,
        name = name,
        chams = chams,
    }

    ESPPool[playerName] = esp
    return esp
end

local function RemoveESPForPlayer(playerName)
    local esp = ESPPool[playerName]
    if not esp then return end

    if #ESPObjectPool.box < ESPObjectPoolMAX then
        esp.box.Visible = false
        table_insert(ESPObjectPool.box, esp.box)
    else
        pcall(function() esp.box:Remove() end)
    end

    if #ESPObjectPool.health < ESPObjectPoolMAX then
        esp.health.Visible = false
        table_insert(ESPObjectPool.health, esp.health)
    else
        pcall(function() esp.health:Remove() end)
    end

    if #ESPObjectPool.name < ESPObjectPoolMAX then
        esp.name.Visible = false
        table_insert(ESPObjectPool.name, esp.name)
    else
        pcall(function() esp.name:Remove() end)
    end

    if #ESPObjectPool.chams < ESPObjectPoolMAX then
        esp.chams.Enabled = false
        esp.chams.Adornee = nil
        esp.chams.Parent = nil
        table_insert(ESPObjectPool.chams, esp.chams)
    else
        pcall(function() esp.chams:Destroy() end)
    end

    ESPPool[playerName] = nil
end

local function ClearAllESP()
    for name in pairs(ESPPool) do
        RemoveESPForPlayer(name)
    end
    for _, obj in ipairs(ESPObjectPool.box) do pcall(function() obj:Remove() end) end
    for _, obj in ipairs(ESPObjectPool.health) do pcall(function() obj:Remove() end) end
    for _, obj in ipairs(ESPObjectPool.name) do pcall(function() obj:Remove() end) end
    for _, obj in ipairs(ESPObjectPool.chams) do pcall(function() obj:Destroy() end) end
    ESPObjectPool = { box = {}, health = {}, name = {}, chams = {} }
end

-- ============================================================
-- 9. BOUNDING BOX
-- ============================================================
local function GetBoundingVectors(char)
    if not char then return nil, nil, false end
    local ok, cf, size = pcall(function()
        local c, s = char:GetBoundingBox()
        return c, s
    end)
    if not ok or not cf or not size then return nil, nil, false end

    local padding = Settings.ESP.BoxPadding
    size = size + Vector3_new(padding, padding, padding)

    local corners = {
        cf * CFrame.new(-size.X/2,  size.Y/2,  size.Z/2),
        cf * CFrame.new( size.X/2,  size.Y/2,  size.Z/2),
        cf * CFrame.new(-size.X/2, -size.Y/2,  size.Z/2),
        cf * CFrame.new( size.X/2, -size.Y/2,  size.Z/2),
        cf * CFrame.new(-size.X/2,  size.Y/2, -size.Z/2),
        cf * CFrame.new( size.X/2,  size.Y/2, -size.Z/2),
        cf * CFrame.new(-size.X/2, -size.Y/2, -size.Z/2),
        cf * CFrame.new( size.X/2, -size.Y/2, -size.Z/2),
    }

    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local anyOnScreen = false
    local cam = GetCamera()

    for _, corner in ipairs(corners) do
        local sp, onScreen = cam:WorldToViewportPoint(corner.Position)
        if onScreen then
            anyOnScreen = true
            if sp.X < minX then minX = sp.X end
            if sp.Y < minY then minY = sp.Y end
            if sp.X > maxX then maxX = sp.X end
            if sp.Y > maxY then maxY = sp.Y end
        end
    end

    if not anyOnScreen then return nil, nil, false end

    local boxPos = Vector2_new(minX, minY)
    local boxSize = Vector2_new(maxX - minX, maxY - minY)

    if boxSize.X > 5000 or boxSize.Y > 5000 or boxSize.X < 1 or boxSize.Y < 1 then
        return nil, nil, false
    end

    return boxPos, boxSize, true
end

