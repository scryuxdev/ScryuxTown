-- 17.7. BULLET TRACERS
-- ============================================================
local function AcquireTracer()
    local t = table_remove(TracerPool)
    if t then
        t.Visible = false
        return t
    end
    t = Drawing.new("Line")
    t.Thickness = 2
    t.Visible = false
    return t
end

local function ReleaseTracer(t)
    if not t then return end
    t.Visible = false
    if #TracerPool < TracerPoolMAX then
        table_insert(TracerPool, t)
    else
        pcall(function() t:Remove() end)
    end
end

local function CreateTracer(fromPos, toPos)
    if not Settings.Visuals.BulletTracers then return end
    if not fromPos or not toPos then return end

    local dist = (fromPos - toPos).Magnitude
    if dist > Settings.Visuals.TracerMaxDistance then return end

    local tracer = AcquireTracer()
    tracer.Color = Settings.Visuals.TracerColor
    tracer.Thickness = Settings.Visuals.TracerThickness
    tracer.Transparency = 1
    tracer.Visible = true

    local data = {
        tracer = tracer,
        fromPos = fromPos,
        toPos = toPos,
        startTime = os_clock(),
        lifetime = Settings.Visuals.TracerLifetime,
    }
    table_insert(ActiveTracers, data)
end

local function UpdateTracers()
    if isScriptUnloaded then return end
    local cam = GetCamera()
    if not cam then return end
    local now = os_clock()
    local i = 1
    while i <= #ActiveTracers do
        local data = ActiveTracers[i]
        local age = now - data.startTime
        if age >= data.lifetime then
            ReleaseTracer(data.tracer)
            table_remove(ActiveTracers, i)
        else
            local t = data.tracer
            local v1, o1 = cam:WorldToViewportPoint(data.fromPos)
            local v2, o2 = cam:WorldToViewportPoint(data.toPos)
            if o1 and o2 then
                t.From = Vector2_new(v1.X, v1.Y)
                t.To = Vector2_new(v2.X, v2.Y)
                t.Transparency = 1 - (age / data.lifetime)
                t.Visible = true
            else
                t.Visible = false
            end
            i = i + 1
        end
    end
end

local tracerLoopConn = nil

local function StartTracerLoop()
    if tracerLoopConn then return end
    tracerLoopConn = RunService.RenderStepped:Connect(UpdateTracers)
end

local function StopTracerLoop()
    if tracerLoopConn then
        pcall(function() tracerLoopConn:Disconnect() end)
        tracerLoopConn = nil
    end
    for _, data in ipairs(ActiveTracers) do
        ReleaseTracer(data.tracer)
    end
    ActiveTracers = {}
end

local function ClearAllTracers()
    for _, data in ipairs(ActiveTracers) do
        ReleaseTracer(data.tracer)
    end
    ActiveTracers = {}
    for _, t in ipairs(TracerPool) do
        pcall(function() t:Remove() end)
    end
    TracerPool = {}
end

StartTracerLoop()

