local function StartXRay()
    if xrayThread then return end
    xrayActive = true
    xrayThread = task.spawn(function()
        local partList, lastRefresh = {}, 0
        local lastPartCleanup = 0
        while xrayActive do
            pcall(function()
                local cam = GetCamera()
                local camPos = cam.CFrame.Position
                local camLook = cam.CFrame.LookVector
                local now = os_clock()
                if now - lastRefresh > 2 then
                    partList = {}
                    for _, part in ipairs(Workspace:GetDescendants()) do
                        if part:IsA("BasePart")
                            and part ~= cam
                            and (not LP.Character or not part:IsDescendantOf(LP.Character))
                            and part.Transparency < 0.9 and part.Parent
                        then
                            if originalTransparency[part] == nil then
                                originalTransparency[part] = part.Transparency
                            end
                            table_insert(partList, part)
                        end
                    end
                    lastRefresh = now
                end
                for _, part in ipairs(partList) do
                    if not part.Parent then continue end
                    local orig = originalTransparency[part] or 0
                    local nl = part.Name:lower()
                    if string_find(nl, "floor") or string_find(nl, "ground")
                        or string_find(nl, "terrain")
                        or (part.Parent and part.Parent:IsA("Tool"))
                    then
                        part.Transparency = orig
                        continue
                    end
                    local dir = (part.Position - camPos)
                    if dir.Magnitude > 0.1 then
                        local dot = camLook:Dot(dir.Unit)
                        if dot > 0.3 then
                            part.Transparency = math.max(orig, 0.75)
                        else
                            part.Transparency = orig
                        end
                    end
                end
                if now - lastPartCleanup > 30 then
                    lastPartCleanup = now
                    for part in pairs(originalTransparency) do
                        if not part or not part.Parent then
                            originalTransparency[part] = nil
                        end
                    end
                end
            end)
            task.wait(0.15)
        end
    end)
end

local function StopXRay()
    xrayActive = false
    if xrayThread then task.cancel(xrayThread); xrayThread = nil end
    pcall(function()
        for part, t in pairs(originalTransparency) do
            if part and part.Parent then part.Transparency = t end
        end
        originalTransparency = {}
    end)
end

