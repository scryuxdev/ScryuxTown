local function FindAllMods(folder)
    local found = {}
    local function recurse(parent)
        if not parent then return end
        for _, child in ipairs(parent:GetChildren()) do
            if child:FindFirstChild("Stats") then
                table_insert(found, child)
            end
            if child:IsA("Folder") or child:IsA("Tool") or child:IsA("Model")
                or child:IsA("Part") or child:IsA("BasePart") then
                pcall(recurse, child)
            end
        end
    end
    pcall(recurse, folder)
    return found
end

local function GetAllWeapons()
    local allWeapons = {}
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        for _, i in ipairs(bp:GetChildren()) do
            if i:IsA("Tool") then table_insert(allWeapons, i) end
        end
    end
    local char = LP.Character
    if char then
        for _, i in ipairs(char:GetChildren()) do
            if i:IsA("Tool") and not table.find(allWeapons, i) then
                table_insert(allWeapons, i)
            end
        end
    end
    return allWeapons
end

local function ApplyWeaponMod(weapon, paramName, value)
    if not weapon or not weapon:IsDescendantOf(game) then return false end
    local af = weapon:FindFirstChild("AttachmentFolder")
    if not af then return false end
    local mods = FindAllMods(af)
    local applied = false
    for _, mod in ipairs(mods) do
        local statFolder = mod:FindFirstChild("Stats")
        if statFolder then
            local stat = statFolder:FindFirstChild(paramName)
            if stat and stat:IsA("NumberValue") then
                if not weaponOriginalValues[weapon] then
                    weaponOriginalValues[weapon] = {}
                end
                if not weaponOriginalValues[weapon][paramName] then
                    weaponOriginalValues[weapon][paramName] = stat.Value
                end
                stat.Value = value
                applied = true
            end
        end
    end
    return applied
end

local function RestoreAllWeaponMods()
    for weapon, params in pairs(weaponOriginalValues) do
        if weapon and weapon:IsDescendantOf(game) then
            for paramName, originalValue in pairs(params) do
                ApplyWeaponMod(weapon, paramName, originalValue)
            end
        end
    end
    weaponOriginalValues = {}
end

